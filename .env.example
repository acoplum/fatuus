# Copie para .env e preencha com valores reais. .env nunca é commitado.
FATUUS_BASIC_AUTH_USER=
FATUUS_BASIC_AUTH_PASSWORD=

# Provedor da Camada 1: gemini (padrão), ollama ou vllm.
FATUUS_MODEL_PROVIDER=gemini

# gemini: exige GOOGLE_API_KEY. FATUUS_MODEL_ID sobrepõe o modelo padrão.
GOOGLE_API_KEY=
FATUUS_GEMINI_MODEL=gemini-3.7-flash

# ollama: local, sem envio de texto a API externa.
# FATUUS_OLLAMA_HOST=http://localhost:11434
# FATUUS_MODEL_ID=llama3.1

# vllm: API OpenAI-compatible local. FATUUS_MODEL_ID é obrigatório.
# VLLM_BASE_URL=http://localhost:8000/v1/
# VLLM_API_KEY=local
# FATUUS_MODEL_ID=

# Origens CORS do deploy (separadas por vírgula). Sem isso, só localhost.
# FATUUS_CORS_ORIGINS=https://exemplo.run.app
